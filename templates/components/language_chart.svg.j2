<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 60" fill="none">
  {% set ns = namespace(offset=0, lx=40) %}
  {% for lang, pct in stats.languages.items() %}
  {% set seg_width = (pct / 100 * 720) | round | int %}
  <rect x="{{ 40 + ns.offset }}" y="10" width="{{ seg_width }}" height="4" fill="{{ lang_color(lang) }}"/>
  {% set ns.offset = ns.offset + seg_width + 2 %}
  {% endfor %}
  {% set ns.lx = 40 %}
  {% for lang, pct in stats.languages.items() %}
  <rect x="{{ ns.lx }}" y="28" width="8" height="8" fill="{{ lang_color(lang) }}"/>
  <text x="{{ ns.lx + 12 }}" y="36" font-family="ui-monospace, monospace" font-size="11" fill="#888899">{{ lang }} {{ pct }}%</text>
  {% set ns.lx = ns.lx + (lang | length * 7) + (pct | string | length * 7) + 36 %}
  {% endfor %}
</svg>
