<!DOCTYPE html>
<html lang="en"{% if theme == "light" %} class="theme-light"{% elif theme == "dark" %} class="theme-dark"{% endif %}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ (profile.name if profile and profile.name else (user.name or user.login)) }} — Folio</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
{% set full_name = (profile.name if profile and profile.name else (user.name or user.login)) %}
{% set first_name = full_name.split()[0] if full_name else full_name %}
{% set email = (profile.email if profile and profile.email else (user.email or None)) %}
{% set resume = (profile.resume_url if profile else None) %}
<main class="folio">

  <!-- Eyebrow -->
  <header class="eyebrow">
    <span class="eyebrow-left">Portfolio — {{ generated_at[:4] }}</span>
    {% if profile and profile.available_for_work %}
    <span class="eyebrow-status"><span class="dot"></span>Available for work</span>
    {% endif %}
  </header>

  <!-- Masthead -->
  <section class="masthead">
    <div class="masthead-lead">
      <h1>{{ first_name }}</h1>
      {% if profile and profile.tagline %}
      <p class="masthead-tagline">{{ profile.tagline }}</p>
      {% endif %}
      {% if resume or email %}
      <div class="masthead-actions">
        {% if resume %}
        <a class="btn btn-solid" href="{{ resume }}">Résumé <span aria-hidden="true">↗</span></a>
        {% endif %}
        {% if email %}
        <a class="btn btn-outline" href="mailto:{{ email }}">Email</a>
        {% endif %}
      </div>
      {% endif %}
    </div>
    <div class="masthead-avatar">
      {% if avatar %}
      <img src="{{ avatar }}" alt="{{ full_name }}" />
      {% else %}
      <div class="avatar-mono">{{ full_name[0] | upper }}</div>
      {% endif %}
    </div>
  </section>

  <!-- About -->
  {% if bio %}
  <section class="about">{{ bio }}</section>
  {% endif %}

  <!-- Stack -->
  {% if "top_languages" in stats_show and stats.languages %}
  <section class="stack">
    <span class="label">Stack</span>
    <div class="stack-pills">
      {% for lang in stats.languages %}
      <span class="pill"><span class="pill-dot" style="background:{{ lang | lang_color }};"></span>{{ lang }}</span>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- Selected work -->
  {% if repos %}
  <section class="work">
    <div class="section-head">
      <span class="label">Selected work</span>
      <span class="section-count">{{ repos | length }} projects</span>
    </div>
    <ol class="work-list">
      {% for repo in repos %}
      {% set summary = summaries.get(repo.full_name) %}
      {% set fork_diff = fork_diffs.get(repo.full_name) %}
      <li class="work-item">
        <span class="work-num">{{ '%02d' % loop.index }}</span>
        <div class="work-body">
          <div class="work-title">
            {% if repo.is_private %}
            <span class="work-name">{{ repo.name }}</span>
            {% else %}
            <a class="work-name" href="{{ repo.html_url }}">{{ repo.name }}</a>
            {% endif %}
            {% if repo.is_private %}<span class="tag tag-private">private</span>{% endif %}
            {% if repo.is_fork %}<span class="tag tag-fork">fork</span>{% endif %}
            {% if repo.language %}
            <span class="tag tag-lang"><span class="tag-dot" style="background:{{ repo.language | lang_color }};"></span>{{ repo.language }}</span>
            {% endif %}
          </div>
          {% if summary %}
          <p class="work-desc">{{ summary }}</p>
          {% elif fork_diff %}
          <p class="work-desc">{{ fork_diff }}</p>
          {% elif repo.description %}
          <p class="work-desc">{{ repo.description }}</p>
          {% endif %}
          {% if repo.is_fork and repo.fork_parent %}
          <div class="work-note fork-note">forked from {{ repo.fork_parent }}</div>
          {% endif %}
          {% if repo.is_private and repo.private_reason %}
          <div class="work-note private-note">◦ {{ repo.private_reason }}</div>
          {% endif %}
        </div>
        <div class="work-meta">
          {% if repo.last_updated %}
          <div class="work-date">{{ repo.last_updated.strftime('%b %Y') }}</div>
          {% endif %}
          {% if not repo.is_private %}
          <a class="work-code" href="{{ repo.html_url }}">Code <span aria-hidden="true">↗</span></a>
          {% endif %}
          {% if repo.link %}
          <a class="work-link" href="{{ repo.link.url }}">{{ repo.link.label }} <span aria-hidden="true">↗</span></a>
          {% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  <!-- Activity -->
  {% if stats and stats.contribution_weeks %}
  {% set week_count = stats.contribution_weeks | length %}
  <section class="activity">
    <div class="section-head">
      <span class="label">Activity — last {{ week_count }} week{{ '' if week_count == 1 else 's' }}</span>
      <span class="section-count">{{ stats.contribution_total }} contributions</span>
    </div>
    <div class="heatmap-wrap">
      <div class="heatmap">
        {% for week in stats.contribution_weeks %}
        <div class="heat-week">
          {% for day in week %}
          <div class="heat-cell" data-level="{{ day.level }}"></div>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    </div>
    <div class="heat-legend">
      <span>Less</span>
      <span class="heat-cell" data-level="0"></span>
      <span class="heat-cell" data-level="1"></span>
      <span class="heat-cell" data-level="2"></span>
      <span class="heat-cell" data-level="3"></span>
      <span class="heat-cell" data-level="4"></span>
      <span>More</span>
    </div>
  </section>
  {% endif %}

  <!-- Stat line -->
  {% if stats and stats_show %}
  {% set stat_line = [] %}
  {% if "commits" in stats_show and stats.commits is not none %}{% set _ = stat_line.append((stats.commits, "Commits")) %}{% endif %}
  {% if "pull_requests" in stats_show and stats.pull_requests is not none %}{% set _ = stat_line.append((stats.pull_requests, "Pull requests")) %}{% endif %}
  {% if "issues" in stats_show and stats.issues is not none %}{% set _ = stat_line.append((stats.issues, "Issues")) %}{% endif %}
  {% if "streak" in stats_show and stats.streak_days is not none %}{% set _ = stat_line.append((stats.streak_days, "Day streak")) %}{% endif %}
  {% if stat_line %}
  <section class="stats">
    {% for value, label in stat_line %}
    <div class="stat">
      <div class="stat-value">{{ value }}</div>
      <div class="stat-label">{{ label }}</div>
    </div>
    {% endfor %}
  </section>
  {% endif %}
  {% endif %}

  <!-- CTA -->
  <section class="cta">
    <div class="cta-line">Let&rsquo;s build something.</div>
    {% if resume or email %}
    <div class="cta-actions">
      {% if resume %}
      <a class="btn btn-solid btn-sm" href="{{ resume }}">Résumé <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if email %}
      <a class="btn btn-outline btn-sm" href="mailto:{{ email }}">Email</a>
      {% endif %}
    </div>
    {% endif %}
  </section>

  <!-- Footer -->
  <footer class="foot">
    <span>Built with <a href="https://github.com/joemc3/folio">Folio</a></span>
    <span>Last generated {{ generated_at }}</span>
  </footer>

</main>
</body>
</html>
