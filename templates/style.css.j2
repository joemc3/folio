/* Folio — generated stylesheet (Editorial) */

/* ── Fonts ── */
@font-face {
  font-family: 'JetBrains Mono';
  src: url('fonts/jetbrains-mono-400.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'JetBrains Mono';
  src: url('fonts/jetbrains-mono-600.woff2') format('woff2');
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'JetBrains Mono';
  src: url('fonts/jetbrains-mono-700.woff2') format('woff2');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'DM Sans';
  src: url('fonts/dm-sans-400.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'DM Sans';
  src: url('fonts/dm-sans-500.woff2') format('woff2');
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Instrument Serif';
  src: url('fonts/instrument-serif-400.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Instrument Serif';
  src: url('fonts/instrument-serif-400-italic.woff2') format('woff2');
  font-weight: 400;
  font-style: italic;
  font-display: swap;
}

/* ── Design tokens (dark, default) ── */
:root {
  --bg: #17130c;
  --bg2: #20190f;
  --panel: #1c160d;
  --fg: #f1e9db;
  --fg-mid: #cabfac;
  --fg-dim: #998e7c;
  --border: #342a1b;
  --border-strong: #453923;
  --accent: #ff6a3c;
  --accent-ink: #ff8a63;
  --heat0: #2c2416;
  --shadow: rgba(0, 0, 0, 0.55);

  --serif: 'Instrument Serif', Georgia, 'Times New Roman', serif;
  --sans: 'DM Sans', system-ui, -apple-system, sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
}

/* ── Auto theme: light override via media query ── */
@media (prefers-color-scheme: light) {
  :root {
    --bg: #f7f3ea;
    --bg2: #efe7d7;
    --panel: #fffdf8;
    --fg: #1c1813;
    --fg-mid: #4c4539;
    --fg-dim: #847b6b;
    --border: #e4dccb;
    --border-strong: #d2c7b0;
    --accent: #dd4d27;
    --accent-ink: #b93c1c;
    --heat0: #e9e2d1;
    --shadow: rgba(60, 45, 20, 0.12);
  }
}

/* ── Explicit theme classes ── */
.theme-dark {
  --bg: #17130c;
  --bg2: #20190f;
  --panel: #1c160d;
  --fg: #f1e9db;
  --fg-mid: #cabfac;
  --fg-dim: #998e7c;
  --border: #342a1b;
  --border-strong: #453923;
  --accent: #ff6a3c;
  --accent-ink: #ff8a63;
  --heat0: #2c2416;
  --shadow: rgba(0, 0, 0, 0.55);
}

.theme-light {
  --bg: #f7f3ea;
  --bg2: #efe7d7;
  --panel: #fffdf8;
  --fg: #1c1813;
  --fg-mid: #4c4539;
  --fg-dim: #847b6b;
  --border: #e4dccb;
  --border-strong: #d2c7b0;
  --accent: #dd4d27;
  --accent-ink: #b93c1c;
  --heat0: #e9e2d1;
  --shadow: rgba(60, 45, 20, 0.12);
}

{% if accent_override %}
/* ── Explicit accent override (theme.accent hex) ── */
:root, .theme-dark, .theme-light {
  --accent: {{ accent_override }};
  --accent-ink: {{ accent_override }};
}
{% endif %}

/* ── Reset ── */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ── Base ── */
body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

a {
  color: inherit;
  text-decoration: none;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 2px;
}

/* ── Centered content column, full-bleed page ── */
.folio {
  max-width: 820px;
  margin: 0 auto;
  padding: 60px 40px 80px;
}

/* Shared mono section label */
.label {
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--fg-dim);
}

/* ── Eyebrow ── */
.eyebrow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 44px;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--fg-dim);
}

.eyebrow-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--accent);
}

.eyebrow-status .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

/* ── Masthead ── */
.masthead {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 32px;
  align-items: end;
  padding-bottom: 34px;
  border-bottom: 2px solid var(--fg);
}

.masthead h1 {
  font-family: var(--serif);
  font-weight: 400;
  font-size: clamp(64px, 12vw, 120px);
  line-height: 0.88;
  letter-spacing: -2px;
  color: var(--fg);
}

.masthead-tagline {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 400;
  font-size: clamp(22px, 3.4vw, 29px);
  line-height: 1.24;
  color: var(--fg-mid);
  max-width: 540px;
  margin-top: 22px;
}

.masthead-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.masthead-avatar {
  width: 98px;
  height: 98px;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.masthead-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.avatar-mono {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  color: #fff;
  font-family: var(--serif);
  font-size: 46px;
  line-height: 1;
}

/* ── Buttons ── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: var(--sans);
  font-weight: 600;
  font-size: 14px;
  line-height: 1;
  padding: 13px 24px;
  border-radius: 11px;
  border: 1px solid transparent;
  transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn-solid {
  background: var(--accent);
  color: #fff;
}

.btn-solid:hover {
  background: var(--accent-ink);
}

.btn-outline {
  border-color: var(--border-strong);
  color: var(--fg);
}

.btn-outline:hover {
  border-color: var(--fg);
  background: var(--bg2);
}

.btn-sm {
  padding: 11px 20px;
  font-size: 13px;
}

/* ── About ── */
.about {
  margin-top: 46px;
  max-width: 660px;
  font-family: var(--sans);
  font-size: 19px;
  line-height: 1.72;
  color: var(--fg-mid);
}

/* ── Stack ── */
.stack {
  margin-top: 52px;
}

.stack .label {
  display: block;
  margin-bottom: 16px;
}

.stack-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 7px 15px;
  font-family: var(--sans);
  font-weight: 500;
  font-size: 13px;
  color: var(--fg-mid);
}

.pill-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ── Section head (work + activity) ── */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16px;
  margin-bottom: 4px;
}

.section-count {
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 1px;
  color: var(--fg-dim);
}

/* ── Selected work ── */
.work {
  margin-top: 64px;
}

.work-list {
  list-style: none;
}

.work-item {
  display: grid;
  grid-template-columns: 60px 1fr 152px;
  gap: 24px;
  align-items: baseline;
  padding: 26px 4px;
  border-top: 1px solid var(--border);
  transition: background 0.15s ease;
}

.work-item:hover {
  background: var(--bg2);
}

.work-num {
  font-family: var(--serif);
  font-size: 34px;
  line-height: 1;
  color: var(--fg-dim);
}

.work-title {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10px;
}

.work-name {
  font-family: var(--serif);
  font-size: 27px;
  line-height: 1.05;
  color: var(--fg);
}

a.work-name {
  border-bottom: 2px solid transparent;
  transition: border-color 0.15s ease;
}

a.work-name:hover {
  border-bottom-color: var(--accent);
}

.tag {
  font-family: var(--mono);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-radius: 4px;
  line-height: 1;
  white-space: nowrap;
}

.tag-private {
  font-size: 10px;
  padding: 3px 6px;
  border: 1px solid var(--accent);
  color: var(--accent);
}

.tag-fork {
  font-size: 10px;
  padding: 3px 6px;
  border: 1px solid var(--border);
  color: var(--fg-dim);
}

.tag-lang {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: var(--fg-dim);
  border: none;
  text-transform: none;
  letter-spacing: 0.5px;
}

.tag-lang .tag-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.work-desc {
  margin-top: 10px;
  max-width: 560px;
  font-family: var(--sans);
  font-size: 15.5px;
  line-height: 1.6;
  color: var(--fg-mid);
}

.work-note {
  margin-top: 8px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--fg-dim);
}

.work-note.fork-note {
  font-family: var(--serif);
  font-style: italic;
  font-size: 15px;
}

.work-meta {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
}

.work-date {
  font-family: var(--mono);
  font-size: 13px;
  color: var(--fg-dim);
}

.work-code {
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 500;
  color: var(--fg-mid);
  transition: color 0.15s ease;
}

.work-code:hover {
  color: var(--accent);
}

.work-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--sans);
  font-size: 12px;
  font-weight: 500;
  border: 1px solid var(--accent);
  color: var(--accent);
  border-radius: 999px;
  padding: 4px 11px;
  transition: background 0.15s ease, color 0.15s ease;
}

.work-link:hover {
  background: var(--accent);
  color: #fff;
}

/* ── Activity heatmap ── */
.activity {
  margin-top: 64px;
}

.heatmap-wrap {
  margin-top: 20px;
  overflow-x: auto;
  padding-bottom: 4px;
}

.heatmap {
  display: flex;
  gap: 3px;
  width: max-content;
}

.heat-week {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.heat-cell {
  width: 12px;
  height: 12px;
  border-radius: 2.5px;
  background: var(--heat0);
}

.heat-cell[data-level="1"] { background: var(--accent); opacity: 0.28; }
.heat-cell[data-level="2"] { background: var(--accent); opacity: 0.50; }
.heat-cell[data-level="3"] { background: var(--accent); opacity: 0.74; }
.heat-cell[data-level="4"] { background: var(--accent); opacity: 1; }

.heat-legend {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 16px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--fg-dim);
}

.heat-legend .heat-cell {
  display: inline-block;
}

/* ── Stat line ── */
.stats {
  margin-top: 56px;
  display: flex;
  flex-wrap: wrap;
}

.stat {
  flex: 1;
  min-width: 120px;
  padding: 4px 24px;
  border-left: 1px solid var(--border);
}

.stat:first-child {
  padding-left: 0;
  border-left: none;
}

.stat-value {
  font-family: var(--sans);
  font-weight: 700;
  font-size: 30px;
  line-height: 1;
  letter-spacing: -0.5px;
  color: var(--fg);
}

.stat-label {
  margin-top: 8px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--fg-dim);
}

/* ── CTA ── */
.cta {
  margin-top: 64px;
  padding-top: 32px;
  border-top: 2px solid var(--fg);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
}

.cta-line {
  font-family: var(--serif);
  font-size: 30px;
  line-height: 1.1;
  color: var(--fg);
}

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

/* ── Footer ── */
.foot {
  margin-top: 40px;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.5px;
  color: var(--fg-dim);
}

.foot a {
  color: var(--fg-mid);
  border-bottom: 1px solid var(--border-strong);
  transition: color 0.15s ease, border-color 0.15s ease;
}

.foot a:hover {
  color: var(--accent);
  border-color: var(--accent);
}

/* ── Responsive ── */
@media (max-width: 640px) {
  .folio {
    padding: 40px 20px 60px;
  }

  .masthead {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .masthead-avatar {
    order: -1;
    width: 72px;
    height: 72px;
  }

  .avatar-mono {
    font-size: 34px;
  }

  .work-item {
    grid-template-columns: 40px 1fr;
    gap: 8px 16px;
    padding: 22px 2px;
  }

  .work-num {
    font-size: 26px;
  }

  .work-meta {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
    text-align: left;
    margin-top: 4px;
  }

  .stat {
    padding: 4px 16px;
  }
}

/* Respect reduced motion */
@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
  }
}
