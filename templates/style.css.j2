:root {
  --accent: {{ accent }};
  --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-size-base: 16px;
  --spacing-sm: 0.5rem;
  --spacing-md: 1rem;
  --spacing-lg: 2rem;
}

[data-theme="dark"] {
  --bg: #0d1117;
  --surface: #161b22;
  --text: #e6edf3;
  --text-muted: #8b949e;
  --border: #30363d;
}

[data-theme="light"] {
  --bg: #ffffff;
  --surface: #f6f8fa;
  --text: #1f2328;
  --text-muted: #656d76;
  --border: #d0d7de;
}

*, *::before, *::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: var(--spacing-lg);
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-family);
  font-size: var(--font-size-base);
  line-height: 1.6;
}

a {
  color: var(--accent);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

.profile-header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.avatar {
  width: 128px;
  height: 128px;
  border-radius: 50%;
  border: 3px solid var(--accent);
  margin-bottom: var(--spacing-md);
}

h1 {
  margin: 0;
  font-size: 2rem;
  color: var(--text);
}

.tagline {
  color: var(--text-muted);
  font-size: 1.1rem;
  margin: var(--spacing-sm) 0;
}

.bio {
  color: var(--text-muted);
  margin: var(--spacing-sm) 0;
}

.projects h2 {
  font-size: 1.5rem;
  border-bottom: 1px solid var(--border);
  padding-bottom: var(--spacing-sm);
  color: var(--accent);
}

.project-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: var(--spacing-md);
}

.project-item {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: var(--spacing-md);
}

.project-name {
  font-size: 1.1rem;
  font-weight: 600;
}

.project-description,
.project-summary {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin: var(--spacing-sm) 0;
}

.private-reason {
  display: inline-block;
  background: var(--border);
  border-radius: 4px;
  padding: 0 var(--spacing-sm);
  font-size: 0.8rem;
  color: var(--text-muted);
}

.fork-diff {
  font-size: 0.9rem;
  color: var(--text-muted);
  font-style: italic;
  margin: var(--spacing-sm) 0;
}

.fork-parent {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.language-badge {
  font-size: 0.8rem;
  font-weight: 500;
}

.stars {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-left: var(--spacing-sm);
}

footer {
  text-align: center;
  margin-top: var(--spacing-lg);
  color: var(--text-muted);
  font-size: 0.85rem;
}
