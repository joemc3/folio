<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ user.name or user.login }} — Folio</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body data-theme="{{ theme }}">
  <header class="profile-header">
    {% if avatar %}
    <img class="avatar" src="{{ avatar }}" alt="{{ user.name or user.login }}" />
    {% endif %}
    <h1>{{ user.name or user.login }}</h1>
    {% if bio %}
    <p class="bio">{{ bio }}</p>
    {% endif %}
    {% if profile.tagline %}
    <p class="tagline">{{ profile.tagline }}</p>
    {% endif %}
  </header>

  <main>
    <section class="projects">
      <h2>Projects</h2>
      <ul class="project-list">
        {% for repo in repos %}
        <li class="project-item{% if repo.is_fork %} project-fork{% endif %}{% if repo.is_private %} project-private{% endif %}">
          {% if repo.is_private %}
          <span class="project-name">{{ repo.name }}</span>
          {% if repo.private_reason %}
          <span class="private-reason">{{ repo.private_reason }}</span>
          {% endif %}
          {% else %}
          <a class="project-name" href="{{ repo.html_url }}">{{ repo.name }}</a>
          {% endif %}

          {% if repo.description %}
          <p class="project-description">{{ repo.description }}</p>
          {% endif %}

          {% set summary = summaries.get(repo.full_name) %}
          {% if summary %}
          <p class="project-summary">{{ summary }}</p>
          {% endif %}

          {% if repo.is_fork %}
          {% set fork_diff = fork_diffs.get(repo.full_name) %}
          {% if fork_diff %}
          <p class="fork-diff">{{ fork_diff }}</p>
          {% endif %}
          {% if repo.fork_parent %}
          <span class="fork-parent">Forked from {{ repo.fork_parent }}</span>
          {% endif %}
          {% endif %}

          {% if repo.language %}
          <span class="language-badge" style="color: {{ repo.language | lang_color }}">
            {{ repo.language }}
          </span>
          {% endif %}

          {% if repo.stars %}
          <span class="stars">&#9733; {{ repo.stars }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
  </main>

  <footer>
    <p>Generated by <a href="https://github.com/folio">Folio</a> on {{ generated_at }}</p>
  </footer>
</body>
</html>
